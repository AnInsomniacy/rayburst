{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBundleCommand": "bash scripts/compile-macos-icon.sh"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rayburst",
        "width": 1068,
        "height": 680,
        "minWidth": 373,
        "minHeight": 240,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "transparent": true,
        "visible": false,
        "center": true,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "icon": [
      "icons/macos-dev.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "generated-icons/Assets.car"
    ]
  }
}
