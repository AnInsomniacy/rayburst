{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "fileAssociations": []
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["rayburst"] } }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rayburst",
        "width": 1068,
        "height": 680,
        "minWidth": 373,
        "minHeight": 240,
        "transparent": true,
        "decorations": false,
        "visible": false,
        "center": true,
        "shadow": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-features=msSmoothScrolling --animation-policy=allowed"
      }
    ]
  }
}
