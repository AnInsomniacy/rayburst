{
  "name": "rayburst-website",
  "private": true,
  "type": "module",
  "description": "The Rayburst website: Vue 3, TypeScript, Vite and GSAP.",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\" \"tools/**/*.mjs\" \"*.{ts,js,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,json}\" \"tools/**/*.mjs\" \"*.{ts,js,html}\"",
    "check": "node tools/check.mjs",
    "strings": "python3 tools/sync-ui-strings.py"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vueuse/core": "^14.3.0",
    "gsap": "^3.15.0",
    "reka-ui": "^2.10.5",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.5"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.3",
    "@types/node": "^24.13.1",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "prettier": "^3.8.3",
    "typescript": "~5.6.2",
    "vite": "^6.4.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.1.10"
  }
}
